{
  "name": "via-server",
  "version": "0.2.3",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon --exec \"node --experimental-strip-types --env-file=../.env\" index.js",
    "dev:local": "nodemon --exec \"node --experimental-strip-types --env-file=../.env.dev\" index.js",
    "start": "node --experimental-strip-types --env-file=../.env index.js",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:all": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "express": "^5.0.1",
    "express-session": "^1.19.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.11.0",
    "passport": "^0.7.0",
    "passport-azure-ad": "^4.3.5",
    "passport-local": "^1.0.0",
    "playwright": "^1.52.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.10",
    "nodemon": "^3.1.7",
    "supertest": "^7.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
