# Stage 1: build the Svelte frontend
FROM node:22-alpine AS client-build
WORKDIR /app
COPY package.json ./
COPY client/package*.json ./client/
RUN npm ci --prefix client
COPY client/ ./client/
RUN npm run build --prefix client

# Stage 2: production server image
FROM node:22-slim
ENV NODE_ENV=production
# VIA serves one campus. Compose sets this too, so that a container started by
# hand for a one off task keeps the same clock as the deployed one.
ENV TZ=America/Chicago
WORKDIR /app/server
COPY server/package*.json ./
RUN npm ci --omit=dev
# Install system deps for Chromium first (requires apt-get update on slim),
# then install the browser binary separately. Splitting the two steps avoids
# the retry loop that occurs when --with-deps tries apt-get on an un-updated
# slim image and silently fails, causing playwright to re-download the browser.
# default-mysql-client provides mysqldump and mysql, which the backup and
# restore steps of the cutover shell out to. verifyBackup restores every dump
# and compares row counts before the maintenance window opens, so a dump this
# client cannot produce correctly fails the deploy rather than passing as a
# backup that would not have restored.
RUN apt-get update && \
    apt-get install -y --no-install-recommends default-mysql-client && \
    npx playwright install-deps chromium && \
    rm -rf /var/lib/apt/lists/*
RUN npx playwright install chromium
COPY server/ ./
# Place built frontend where app.js expects it
COPY --from=client-build /app/client/dist ../client/dist

EXPOSE 3001
# Below the container's 1g limit, so V8 collects under pressure instead of the
# cgroup killing a process that still had work it could have refused.
CMD ["node", "--experimental-strip-types", "--max-old-space-size=768", "index.js"]
