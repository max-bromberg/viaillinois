# ── Database ─────────────────────────────────────────────────────────────────
# For local dev (outside Docker), point at your local MySQL instance.
# When running via docker-compose, DB_HOST is set to "db" automatically,
# so only DB_USER, DB_PASSWORD, and DB_NAME are read from this file.
DB_HOST=localhost
DB_PORT=3306
DB_USER=via
DB_PASSWORD=changeme
DB_NAME=via

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:3001

# ── Auth ──────────────────────────────────────────────────────────────────────
# Required for UIUC NetID (Azure AD OIDC) login.
# Leave blank to use local username/password auth only.
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=

# Generate strong random values for production:  openssl rand -hex 32
JWT_SECRET=change_me_in_production
SESSION_SECRET=change_me_in_production

# ── Traffic limits ────────────────────────────────────────────────────────────
# Every one of these has a working default, so none has to be set. They are
# listed here because tuning one is a restart rather than a release, and
# docs/deployment.md explains when to reach for them. Read the Availability tab
# on the admin page before changing any of them.

# Proxies in front of the origin. Two is Cloudflare, then Nginx Proxy Manager.
TRUSTED_PROXY_HOPS=2

# When the platform decides it is overloaded and starts refusing the cheapest
# traffic first. Each signal is measured against its own threshold, so none of
# them depends on knowing the size of the host.
SHED_LAG_MS=200
SHED_MAX_INFLIGHT=200
SHED_MAX_DB_WAITERS=20
SHED_RECOVERY_RATIO=0.6
SHED_RETRY_AFTER_SECONDS=30

# How many callers may queue for a database connection before the queue starts
# refusing at once rather than growing.
DB_QUEUE_LIMIT=50
DB_CONNECT_TIMEOUT_MS=10000

# How long a connection may hold a socket open saying very little. Keep alive is
# deliberately above the edge's idle timeout, so the origin is never the side
# that closes a connection the edge still believes is open.
REQUEST_TIMEOUT_MS=30000
HEADERS_TIMEOUT_MS=35000
KEEPALIVE_TIMEOUT_MS=65000

# What one anonymous caller may take from the public API. The row budget is the
# one that matters against bulk collection, because it measures what was taken
# rather than how it was asked for.
PUBLIC_REQUESTS_PER_MINUTE=120
PUBLIC_ROWS_PER_HOUR=5000
BUDGET_RETRY_AFTER_SECONDS=60

# How refusals are counted and how long the counts are kept.
DENIAL_FLUSH_INTERVAL_MS=60000
DENIAL_RETENTION_DAYS=90
DENIAL_BUFFER_MAX_KEYS=5000
DENIAL_CLIENTS_PER_KEY_MAX=1000

# ── Discord bot ───────────────────────────────────────────────────────────────
# The token the Discord bot presents to the internal service API. Both
# containers read it. Leave it unset and the internal API does not exist.
# Generate it the same way as the secrets above:  openssl rand -hex 32
BOT_SERVICE_TOKEN=

# How long the outbox, which is the log of changes the bot reads, keeps an
# entry, and how often the entries past that window are removed. A bot that has
# been away longer than the retention window rebuilds what it knows from the
# reading endpoints instead, so keeping more than a month buys nothing.
OUTBOX_RETENTION_DAYS=30
OUTBOX_PRUNE_INTERVAL_MS=3600000

# The Discord application the link flow authorizes against, and the key the one
# secret VIA keeps on a person's behalf is sealed with. Leave the client
# identifier unset and the website answers a request to start linking with a
# sentence saying Discord linking is not configured on this deployment.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# The Discord refresh token from the link flow is what lets VIA refresh the
# linked role facts later without asking the person again, and it is stored
# encrypted with this key. Generate it the same way as the secrets above:
# openssl rand -hex 32
DISCORD_LINK_KEY=

# Interest recorded by somebody who has not linked their account is stored
# under a hash of the Discord identifier rather than the identifier itself, and
# this salt is what stops that list being rebuilt by hashing every identifier
# in a server. Leave it unset and interest from anybody who has not linked is
# refused rather than recorded under a hash of nothing. Generate it the same
# way as the secrets above:  openssl rand -hex 32
DISCORD_INTEREST_SALT=
